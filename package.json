{
  "name": "term-highlight",
  "version": "1.2.0",
  "description": "Highlight words, keywords, phrases, and regex matches in a web page without adding span, mark, or any other tag. Built on the CSS Custom Highlight API. Zero dependencies, TypeScript, ESM + CJS.",
  "keywords": [
    "highlight",
    "highlights",
    "highlighter",
    "highlighting",
    "word-highlight",
    "word-highlighter",
    "highlight-words",
    "keyword-highlight",
    "keyword-highlighter",
    "highlight-keywords",
    "text-highlight",
    "text-highlighter",
    "highlight-text",
    "phrase-highlight",
    "search-highlight",
    "highlight-search-terms",
    "term-highlight",
    "term-highlighter",
    "find-in-page",
    "find",
    "search",
    "regex",
    "css-highlight",
    "css-highlight-api",
    "custom-highlight-api",
    "highlight-api",
    "::highlight",
    "no-dom-mutation",
    "no-span",
    "no-mark",
    "mark-alternative",
    "mark.js-alternative",
    "range",
    "dom",
    "text",
    "diacritics",
    "react",
    "contenteditable",
    "typescript"
  ],
  "license": "MIT",
  "author": "Kev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sundown111/term-highlight.git"
  },
  "bugs": {
    "url": "https://github.com/sundown111/term-highlight/issues"
  },
  "homepage": "https://sundown111.github.io/term-highlight/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke.cjs",
    "demo": "npm run build && node scripts/serve.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run smoke && npm run pack:check",
    "prepublishOnly": "npm run verify",
    "test:e2e": "npm run build && playwright test",
    "pack:check": "npm run build && node scripts/pack-check.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "bench": "npm run build && node bench/run.mjs",
    "bench:check": "npm run build && playwright test e2e/perf.spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.9.0",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
